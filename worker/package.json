{
  "name": "museiq-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute museum-db --file=migrations/0001_init.sql --remote",
    "db:init:local": "wrangler d1 execute museum-db --file=migrations/0001_init.sql --local",
    "db:seed": "wrangler d1 execute museum-db --file=migrations/seed.sql --remote",
    "db:seed:local": "wrangler d1 execute museum-db --file=migrations/seed.sql --local",
    "migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/bun": "^1.3.13",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
